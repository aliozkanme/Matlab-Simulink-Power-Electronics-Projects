    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [e,isaret1,isaret2] = periyodik(Vs,t,f)\n% bu programda ucgen dalga T/2 icinde d.c isare"
      "t bicimindedir.\nisaret1=0;\nisaret2=0;\nT=1/f;\nV=1;\nm=2*f*V;\ne=0;\nb=fix(t/T);\n   if (t>=b*T) && t<=(b+0.5)"
      "*T\n       e=m*(t-(b+0.5)*T)+V;\n   end\n   if ( t>(0.5+b)*T && t<=(b+1)*T)\n       e=-m*(t-(b+0.5)*T)+V;\n   en"
      "d\n   e=abs(e);\n   if Vs>0\n       isaret1=1;\n       isaret2=0;\n   else\n       isaret1=0;\n       isaret2=1;"
      "\n   end\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
