  state {
    id			    3
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 0 0]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function giris=istenen(cikis)\nfi=2;\ne=0.00001; \nmax=20; \nfark=0.000001; \ngiris=0;\nf=0;\nV=2"
      "20*sqrt(2); \nfor k=1:max\n    b=(V/pi)*sin(fi); \n    giris=fi-(-(V/pi)*(cos(fi)+1)+cikis)/b;  \n    u=abs(giri"
      "s-fi);\n    u1=2*u/(abs(giris)+fark);\n    fi=giris;\n    f=(-(V/pi)*(cos(fi)+1)+cikis);\nif (u<fark)||(u1<fark)"
      "||(abs(f)<e);\n    break\nend \nend\ngiris=giris*180/pi;"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
  data {
    id			    4
    ssIdNumber		    4
    name		    "cikis"
    scope		    INPUT_DATA
    machine		    1
    props {
      array {
	size			"-1"
      }
